{
	"extends": [
		"@sapphire/ts-config",
		"@sapphire/ts-config/extra-strict",
		"@sapphire/ts-config/decorators"
	],
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "dist",
		"tsBuildInfoFile": "dist/.typecheck.tsbuildinfo",
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src", "drizzle.config.ts"]
}
