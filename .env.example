BotName=ZoraForms
DISCORD_TOKEN=
NODE_ENV=development
# Docker Compose deployment password. Use letters and numbers for simplest URI compatibility.
POSTGRES_PASSWORD=
POSTGRES_APP_USER=zoraforms
POSTGRES_DATABASE=zoraformsdata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLIC_PORT=5432

# PostgreSQL connection
DATABASE_URL=postgresql://zoraforms:password@127.0.0.1:5432/zoraforms
