{
  "name": "zoraforms",
  "version": "0.1.0",
  "main": "dist/index.js",
  "author": "GuikiPT",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-logger": "^4.1.0",
    "@skyra/env-utilities": "^2.0.1",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@sapphire/cli": "^1.9.3",
    "@sapphire/prettier-config": "^2.0.0",
    "@sapphire/ts-config": "^5.0.3",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "tsc-watch": "^6.3.1",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "sapphire": "sapphire",
    "generate": "sapphire generate",
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "watch:start": "tsc-watch --onSuccess \"npm run start\"",
    "format": "prettier --write \"src/\"",
    "check": "tsc --noEmit --tsBuildInfoFile dist/.typecheck.tsbuildinfo",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "prettier": "@sapphire/prettier-config",
  "private": true,
  "description": "ZoraForms Discord bot built with Sapphire and discord.js.",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/GuikinProjects/ZoraForm.git"
  }
}
