{
  "name": "zoraforms",
  "version": "0.1.0",
  "main": "dist/index.js",
  "author": "GuikiPT",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/plugin-logger": "^4.1.0",
    "@skyra/env-utilities": "^2.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@sapphire/cli": "^1.9.3",
    "@sapphire/prettier-config": "^2.0.0",
    "@sapphire/ts-config": "^5.0.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.6",
    "tsc-watch": "^6.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "sapphire": "sapphire",
    "generate": "sapphire generate",
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "watch:start": "tsc-watch --onSuccess \"npm run start\"",
    "format": "prettier --write src tests drizzle.config.ts .prettierrc.cjs",
    "check": "tsc --noEmit --tsBuildInfoFile dist/.typecheck.tsbuildinfo",
    "format:check": "prettier --check src tests drizzle.config.ts .prettierrc.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "private": true,
  "description": "ZoraForms Discord bot built with Sapphire and discord.js.",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/GuikinProjects/ZoraForm.git"
  }
}
